{
  "name": "ai-veil",
  "productName": "AI-Veil",
  "version": "1.0.0",
  "description": "AI-Veil：AI 接管提示器（系统级视觉/听觉/通知反馈）",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "AI-Veil Contributors",
  "scripts": {
    "start": "node scripts/launch.js --adapter file",
    "start:mock": "node scripts/launch.js --adapter mock",
    "start:file": "node scripts/launch.js --adapter file",
    "start:mcp": "node scripts/launch.js --adapter mcp_stdio",
    "dev": "node scripts/launch.js --dev --verbose",
    "lite": "powershell -STA -NoProfile -ExecutionPolicy Bypass -File scripts/veil-lite.ps1",
    "lite:demo": "powershell -STA -NoProfile -ExecutionPolicy Bypass -File scripts/lite-demo.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.11.5",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.ai-veil.desktop",
    "productName": "AI-Veil",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "examples/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "assets/icons/icon.png"
    }
  }
}
